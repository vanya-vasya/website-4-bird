# ---------------------------------------------------------------------------
# FastBird / Yum-Mi — environment variables
# Copy to `.env` for local development:  cp .env.example .env
# ---------------------------------------------------------------------------

# Database (PostgreSQL). Required for dashboard / DB-backed features.
# Use a Neon / Supabase / local Postgres connection string.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# ---------------------------------------------------------------------------
# Authentication (Clerk)
# ---------------------------------------------------------------------------
# Local auth bypass: when USE_CLERK_MOCK=1 the app resolves Clerk to the
# in-repo mocks (lib/clerk-mock.tsx, lib/clerk-server-mock.ts) via
# next.config.js, so you can run the full app WITHOUT any Clerk account.
# The dashboard renders as a mock "Dev User". Set to 0 for real auth.
USE_CLERK_MOCK="1"

# Real Clerk keys — only needed when USE_CLERK_MOCK=0. Get them at clerk.com.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Clerk webhook signing secret (only for /api/webhooks/clerk with real Clerk).
WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Optional third-party integrations (features degrade gracefully if unset)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=""
REPLICATE_API_TOKEN=""
RESEND_API_KEY=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
